{
  "name": "practice-tracks",
  "version": "0.1.0",
  "description": "Automated worship practice track mixing tool",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "practice-mix": "./_internal/src/cli.ts"
  },
  "scripts": {
    "mix": "tsx _internal/src/cli.ts",
    "clean": "tsx _internal/src/cli.ts clean",
    "clean:full": "tsx _internal/src/cli.ts clean --full",
    "type-check": "tsc --project _internal/tsconfig.json --noEmit",
    "lint": "eslint --config _internal/eslint.config.js _internal/src _internal/common _internal/tests _internal/web/src",
    "test": "vitest run --config _internal/vitest.config.ts",
    "test:watch": "vitest --config _internal/vitest.config.ts",
    "build": "tsc --project _internal/tsconfig.json",
    "check": "npm run type-check && npm run lint && npm run test",
    "web": "vite build _internal/web && tsx _internal/src/server.ts",
    "web:dev": "concurrently -n server,vite -c blue,cyan \"tsx watch _internal/src/server.ts\" \"vite _internal/web\"",
    "web:build": "vite build _internal/web",
    "web:build:static": "VITE_BACKEND=browser vite build _internal/web"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "commander": "^12.1.0",
    "express": "^4.21.0",
    "fflate": "^0.8.3",
    "js-yaml": "^4.1.0",
    "multer": "^1.4.5-lts.1",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.5",
    "vitest": "^3.0.0"
  },
  "optionalDependencies": {
    "@ffmpeg/core": "^0.12.6"
  }
}
