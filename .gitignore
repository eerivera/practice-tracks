node_modules/
_internal/dist/
_internal/web/dist/
.DS_Store

# In song directories, only .yaml and .json config files are committed.
# Audio, artwork, output, and future normalized cache are all gitignored.
# Patterns cover both the legacy 1-level layout (songs/<songDir>/) and the
# current 2-level layout (songs/<name>/<keyBpm>/).
songs/**/output/
songs/**/stems/
songs/**/normalized/
songs/**/*.jpg
songs/**/*.jpeg
songs/**/*.png
songs/**/*.m4a
songs/**/*.mp3
songs/**/*.wav
songs/**/*.aac
songs/**/*.flac
# Generated per-song metadata (written by the app on extraction, not user-editable)
songs/**/meta.json
# Browser-mode songs list written to FSA/OPFS root — not committed
songs-list.json

# Zip files are large — not committed
queue-zips/*.zip
processed-zips/*.zip

# Runtime queue state — not committed (edit these manually to set force: true)
queues/to-mix.json
queues/to-upload.json

# User-saved mix config (template is default_mix.yaml — never overwritten by app)
config/user_mix.yaml

# PCO credentials — never commit
.env
.env.*
!.env.example
.claude/settings.local.json

# Playwright E2E — generated on test runs, not committed
playwright-report/
playwright-results-browser/
test-results/

